{
  "manifest_version": 3,
  "name": "Sumrize Meeting Assistant",
  "version": "1.1.0",
  "description": "Sumrize Meeting Assistant – transcript Google Meet via tab audio + STT",

  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],

  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://localhost:*/*",
      "http://127.0.0.1/*",
      "http://127.0.0.1:*/*"
    ]
  },

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_title": "Sumrize Meeting Assistant",
    "default_popup": "popup/popup.html"
  },

  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": [
        "utils/storage.js",
        "content/meet-detector.js",
        "content/transcript-buffer.js",
        "content/caption-observer.js",
        "content/speech-recognizer.js",
        "content/transcript-collector.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "https://meet.google.com/*"
      ]
    }
  ]
}